---
import { building } from '../../data/home';
---

<section id="building" class="mt-16 scroll-mt-24">
  <p class="label">{building.title}</p>
  <p class="mt-2 max-w-2xl text-ink-soft">{building.content}</p>
  <div class="mt-6 grid gap-5 md:grid-cols-2">
    {building.items.map((item) => (
      <article class="flex flex-col rounded-sm border border-rule bg-panel p-5">
        <h3 class="font-display text-xl font-semibold">{item.name}</h3>
        <p class="label mt-1 normal-case tracking-normal">{item.stack}</p>
        <p class="mt-3 flex-1 leading-relaxed text-ink-soft">{item.description}</p>
        {item.links && (
          <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
            {item.links.map((l) => {
              const external = l.url.startsWith('http');
              return (
                <li>
                  <a href={l.url} rel={external ? 'noopener' : undefined} class="text-accent hover:underline">
                    {l.label}{external && <span aria-hidden="true"> ↗</span>}
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </article>
    ))}
  </div>
</section>
